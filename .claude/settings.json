{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "EDITOR": "vim",
    "LANG": "ja_JP.UTF-8",
    "LC_ALL": "ja_JP.UTF-8"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/scripts/notify-waiting-input.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/scripts/notify-waiting-input.sh",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "claude-code-hooks notify 'Claude Code' 'パーミッションが必要です'",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "claude-code-hooks save",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/scripts/validate-edit.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "claude-code-hooks save",
            "statusMessage": "Obsidian にセッションを保存中...",
            "timeout": 120,
            "type": "command"
          },
          {
            "command": "claude-code-hooks notify 'Claude Code' 'セッションの保存が完了しました'",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/yui.sakamoto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "claude-code-hooks save",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "claude-code-hooks save",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "model": "claude-fable-5[1m]",
  "otelHeadersHelper": "/Users/yui.sakamoto/.claude/scripts/dd-otel-headers.sh",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(go *)",
      "Bash(fish -c *)",
      "Bash(brew *)",
      "Bash(mise *)",
      "Bash(afplay *)",
      "Bash(./setup.sh)",
      "Bash(shellcheck *)",
      "Bash(gh *)",
      "Bash(uv *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen"
}