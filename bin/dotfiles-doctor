#!/usr/bin/env bash
# dotfiles-doctor
#
# dotfiles 環境が期待状態（symlink構成・秘密情報混入なし・構文正当性・
# 必須ツール導入）にあるかを検査し、レポートする standalone コマンド。
# setup.sh とは独立して動作する（setup.sh doctor からも呼ばれる）。
#
# Usage:
#   bin/dotfiles-doctor
#
# 終了コード: fail が1件でもあれば 1、それ以外は 0。
set -uo pipefail
# 個別チェックの失敗で即死しないよう -e は使わない

# リポジトリのルートをスクリプト自身の位置から解決する（ハードコード禁止）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
OS="$(uname -s)"

COUNT_OK=0
COUNT_WARN=0
COUNT_FAIL=0

# 色付き出力用エスケープシーケンス
COLOR_OK=$'\033[1;32m'
COLOR_WARN=$'\033[1;33m'
COLOR_FAIL=$'\033[1;31m'
COLOR_RESET=$'\033[0m'

ok() {
  printf '%s[ok]%s   %s\n' "$COLOR_OK" "$COLOR_RESET" "$1"
  COUNT_OK=$((COUNT_OK + 1))
}

warn() {
  printf '%s[warn]%s %s\n' "$COLOR_WARN" "$COLOR_RESET" "$1"
  COUNT_WARN=$((COUNT_WARN + 1))
}

fail() {
  printf '%s[fail]%s %s\n' "$COLOR_FAIL" "$COLOR_RESET" "$1"
  COUNT_FAIL=$((COUNT_FAIL + 1))
}

section() {
  printf '\n\033[1m== %s ==\033[0m\n' "$1"
}

# --- symlink 検査 -----------------------------------------------------
# $1: 表示名, $2: symlink先(target), $3: 期待するリンク元(src)
check_symlink() {
  local label="$1" target="$2" expected_src="$3"

  if [ -L "$target" ]; then
    local actual_src
    actual_src="$(readlink "$target")"
    if [ "$actual_src" != "$expected_src" ]; then
      fail "$label: $target のリンク先が想定と異なる (actual: $actual_src, expected: $expected_src)"
    elif [ ! -e "$target" ]; then
      # symlink は張られているがリンク先の実体が無い状態。
      # リポジトリからファイルを消しただけだとここに落ちる。symlink の
      # 存在だけを見ていると ok と誤判定するため、実体の有無も確かめる。
      fail "$label: $target はリンク切れです (リンク先 $expected_src が存在しません)"
    else
      ok "$label: $target -> $expected_src"
    fi
  elif [ -e "$target" ]; then
    fail "$label: $target は symlink ではなく実体ファイル/ディレクトリです"
  else
    warn "$label: $target が存在しません"
  fi
}

section "symlink 検査 (\$HOME直下)"
check_symlink ".gitconfig" "$HOME/.gitconfig" "$REPO_DIR/.gitconfig"
check_symlink ".gitignore" "$HOME/.gitignore" "$REPO_DIR/.gitignore"
check_symlink ".tmux.conf" "$HOME/.tmux.conf" "$REPO_DIR/.tmux.conf"
# zsh は ZDOTDIR 方式。$HOME 直下にあるべきなのは .zshenv だけ。
check_symlink ".zshenv" "$HOME/.zshenv" "$REPO_DIR/.zshenv"
if [ -e "$HOME/.zshrc" ] || [ -L "$HOME/.zshrc" ]; then
  fail ".zshrc: $HOME/.zshrc が残っています（ZDOTDIR 方式では読まれないため退避すべき）"
else
  ok ".zshrc: $HOME/.zshrc は存在しません（ZDOTDIR 方式として正しい）"
fi

section "symlink 検査 (\$HOME/.config)"
config_targets=(zsh sheldon atuin fish nvim starship.toml mise herdr)
if [ "$OS" = "Darwin" ]; then
  config_targets+=(karabiner ghostty cmux)
fi
for t in "${config_targets[@]}"; do
  check_symlink ".config/$t" "$HOME/.config/$t" "$REPO_DIR/$t"
done

section "symlink 検査 (\$HOME/.claude)"
# ~/.claude 自体はランタイム状態 (credentials, projects 等) を含む実体ディレクトリで
# なければならない。symlink になっているとリポジトリにランタイム状態が
# 混入する危険な構成になるためエラー扱いとする。
if [ -L "$HOME/.claude" ]; then
  fail ".claude: $HOME/.claude が symlink になっています（実体ディレクトリであるべき。ランタイム状態がリポジトリに混入する危険があります）"
elif [ -d "$HOME/.claude" ]; then
  ok ".claude: $HOME/.claude は実体ディレクトリです"
else
  warn ".claude: $HOME/.claude が存在しません"
fi

claude_items=(CLAUDE.md agents skills scripts settings.json .env.example)
for item in "${claude_items[@]}"; do
  check_symlink ".claude/$item" "$HOME/.claude/$item" "$REPO_DIR/.claude/$item"
done

# --- 秘密情報検査 -------------------------------------------------------
section "秘密情報検査"
if command -v git >/dev/null 2>&1; then
  tracked_secrets="$(git -C "$REPO_DIR" ls-files 2>/dev/null | grep -E '(^|/)(\.credentials\.json|settings\.local\.json|history\.jsonl)$' || true)"
  if [ -z "$tracked_secrets" ]; then
    ok "git 追跡ファイルに .credentials.json / settings.local.json / history.jsonl は含まれていません"
  else
    fail "git 追跡ファイルに秘密情報の可能性があるファイルが含まれています:"$'\n'"$tracked_secrets"
  fi
else
  warn "git コマンドが見つからないため秘密情報検査をスキップしました"
fi

# --- 構文検査 -----------------------------------------------------------
section "構文検査"

if [ -f "$REPO_DIR/.claude/settings.json" ]; then
  if command -v jq >/dev/null 2>&1; then
    if jq empty "$REPO_DIR/.claude/settings.json" >/dev/null 2>&1; then
      ok ".claude/settings.json は valid JSON です"
    else
      fail ".claude/settings.json が invalid JSON です"
    fi
  elif command -v python3 >/dev/null 2>&1; then
    if python3 -m json.tool "$REPO_DIR/.claude/settings.json" >/dev/null 2>&1; then
      ok ".claude/settings.json は valid JSON です"
    else
      fail ".claude/settings.json が invalid JSON です"
    fi
  else
    warn ".claude/settings.json の JSON 検証をスキップしました (jq/python3 が見つかりません)"
  fi
else
  warn ".claude/settings.json が見つかりません"
fi

if [ -f "$REPO_DIR/setup.sh" ]; then
  if bash -n "$REPO_DIR/setup.sh" 2>/dev/null; then
    ok "setup.sh は bash -n を通過しました"
  else
    fail "setup.sh が bash -n に失敗しました"
  fi
else
  warn "setup.sh が見つかりません"
fi

if command -v zsh >/dev/null 2>&1; then
  zsh_fail=0
  zsh_checked=0
  # conf.d/*.zsh・.zshrc・.zshenv・拡張子を持たない autoload 関数をまとめて見る
  for f in "$REPO_DIR/.zshenv" "$REPO_DIR/zsh/.zshrc" \
    "$REPO_DIR"/zsh/conf.d/*.zsh "$REPO_DIR"/zsh/functions/*; do
    [ -f "$f" ] || continue
    zsh_checked=$((zsh_checked + 1))
    if ! zsh -n "$f" 2>/dev/null; then
      fail "${f#"$REPO_DIR"/} が zsh -n に失敗しました"
      zsh_fail=1
    fi
  done
  if [ "$zsh_checked" -eq 0 ]; then
    warn "zsh の設定ファイルが見つかりませんでした"
  elif [ "$zsh_fail" -eq 0 ]; then
    ok "zsh の設定ファイル ${zsh_checked} 件はすべて zsh -n を通過しました"
  fi
else
  warn "zsh コマンドが見つからないため zsh 構文検査をスキップしました"
fi

if command -v fish >/dev/null 2>&1; then
  if [ -d "$REPO_DIR/fish/conf.d" ]; then
    fish_fail=0
    for f in "$REPO_DIR"/fish/conf.d/*.fish; do
      [ -f "$f" ] || continue
      if ! fish -n "$f" 2>/dev/null; then
        fail "fish/conf.d/$(basename "$f") が fish -n に失敗しました"
        fish_fail=1
      fi
    done
    if [ "$fish_fail" -eq 0 ]; then
      ok "fish/conf.d/*.fish はすべて fish -n を通過しました"
    fi
  else
    warn "fish/conf.d ディレクトリが見つかりません"
  fi
else
  warn "fish コマンドが見つからないため fish 構文検査をスキップしました"
fi

# --- 生成物の混入検査 ---------------------------------------------------
# ~/.config は repo への symlink なので、ツールが設定ディレクトリに状態を
# 書き込むと repo が汚れる。補完キャッシュや履歴の落とし穴を機械的に検出する。
section "生成物の混入検査"
strays="$(find "$REPO_DIR/zsh" "$REPO_DIR/cmux" "$REPO_DIR/sheldon" -maxdepth 1 \
  \( -name '.zcompdump*' -o -name 'zcompdump*' -o -name 'history' -o -name 'plugins.lock' \) \
  2>/dev/null)"
if [ -z "$strays" ]; then
  ok "repo にツールの生成物 (zcompdump / history / plugins.lock) は落ちていません"
else
  fail "repo にツールの生成物が落ちています（出力先の設定を見直してください）:"$'\n'"$strays"
fi

# --- ツール検査 ---------------------------------------------------------
section "ツール検査"
tools=(brew mise zsh sheldon starship fzf atuin zoxide eza delta lazygit hunk
  ghq tmux nvim fish jq shellcheck gh)
for t in "${tools[@]}"; do
  if command -v "$t" >/dev/null 2>&1; then
    ok "$t が見つかりました ($(command -v "$t"))"
  else
    warn "$t が見つかりません"
  fi
done

# .gitconfig が pager=delta を要求するため、delta 欠如は warn でなく fail とする。
# delta が無いと git diff / log / show が軒並みエラーになり git 自体が使えなくなる。
if git config --file "$REPO_DIR/.gitconfig" core.pager 2>/dev/null | grep -q delta; then
  if command -v delta >/dev/null 2>&1; then
    ok "git pager (delta) が利用可能です"
  else
    fail "gitconfig が pager=delta を指定していますが delta が見つかりません (git diff が壊れます)"
  fi
fi

# .tmux.conf 末尾の `run '~/.tmux/plugins/tpm/tpm'` は tpm 本体を必要とする。
# 無い場合でも tmux は起動するがプラグインが読まれないため warn 止まり。
if [ -d "$HOME/.tmux/plugins/tpm" ]; then
  ok "tpm (tmux plugin manager) が導入されています"
else
  warn "tpm が未導入です (install/common-post.sh で導入されます)"
fi

# --- サマリ ---------------------------------------------------------
section "サマリ"
printf '%sok: %d%s  %swarn: %d%s  %sfail: %d%s\n' \
  "$COLOR_OK" "$COUNT_OK" "$COLOR_RESET" \
  "$COLOR_WARN" "$COUNT_WARN" "$COLOR_RESET" \
  "$COLOR_FAIL" "$COUNT_FAIL" "$COLOR_RESET"

if [ "$COUNT_FAIL" -gt 0 ]; then
  exit 1
fi
exit 0
