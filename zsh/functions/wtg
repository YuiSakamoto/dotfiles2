# 名前を指定して git worktree へ移動する。
# fish/functions/wtg.fish から移植。
emulate -L zsh

if (( $# == 0 )); then
  print -u2 "Usage: wtg <worktree-name>"
  print -u2 "Available worktrees:"
  git worktree list
  return 1
fi

local git_root
git_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  print -u2 "Error: Not in a git repository"
  return 1
}

local worktree_name="$1"
local worktree_path
worktree_path="$(git worktree list | awk -v n="$worktree_name" '$1 ~ "/" n "$" { print $1; exit }')"

if [[ -z "$worktree_path" ]]; then
  # git worktree list に出ない場合は .git/worktrees/ 以下も見る
  local alt_path="$git_root/.git/worktrees/$worktree_name"
  if [[ -d "$alt_path" ]]; then
    worktree_path="$alt_path"
  else
    print -u2 "Worktree not found: $worktree_name"
    print -u2 "Available worktrees:"
    git worktree list
    return 1
  fi
fi

cd "$worktree_path" || return 1
print "Moved to worktree: $worktree_name"
git branch --show-current
